.dialog-mask { position: fixed; z-index: 9000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 40rpx; box-sizing: border-box; background: rgba(18, 29, 46, .44); }
.dialog-card { width: 100%; max-width: 650rpx; overflow: hidden; border-radius: 22rpx; background: #fff; box-shadow: 0 18rpx 48rpx rgba(16, 34, 62, .18); }
.dialog-title { padding: 24rpx 24rpx 10rpx; color: #172033; font-size: 29rpx; font-weight: 700; line-height: 40rpx; }
.dialog-body { max-height: 52vh; padding: 4rpx 24rpx 18rpx; box-sizing: border-box; }
.dialog-message { display: block; color: #657386; font-size: 23rpx; line-height: 34rpx; white-space: pre-wrap; word-break: break-all; }
.dialog-footer { display: flex; gap: 10rpx; padding: 8rpx 14rpx 12rpx; border-top: 1rpx solid #edf0f4; }
.dialog-action-touch { min-width: 0; min-height: 76rpx; flex: 1; display: flex; align-items: center; justify-content: center; }
.dialog-action-visual { width: 100%; height: 62rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 13rpx; font-size: 23rpx; font-weight: 650; }
.dialog-cancel { color: #6f7c8f; background: #f2f4f7; }
.dialog-confirm { color: #fff; background: #2d70d8; }
.dialog-danger .dialog-confirm { background: #c33b35; }
.dialog-warning .dialog-confirm { background: #b66b24; }
.dialog-privacy .dialog-title { color: #8a4b00; }
.dialog-confirm.disabled { opacity: .55; }
