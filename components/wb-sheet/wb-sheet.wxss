.sheet-mask { position: fixed; z-index: 9000; top: 0; right: 0; bottom: 0; left: 0; background: rgba(18, 29, 46, .44); }
.sheet-card { position: fixed; z-index: 9001; left: 24rpx; right: 24rpx; display: flex; flex-direction: column; overflow: hidden; box-sizing: border-box; border-radius: 22rpx 22rpx 0 0; background: #fff; box-shadow: 0 18rpx 48rpx rgba(16, 34, 62, .18); }
.sheet-header { flex: none; padding: 22rpx 22rpx 12rpx; }
.sheet-title { color: #172033; font-size: 29rpx; font-weight: 700; line-height: 40rpx; }
.sheet-description { margin-top: 7rpx; color: #7f8b9c; font-size: 20rpx; line-height: 30rpx; }
.sheet-body { min-height: 0; flex: 1; padding: 0 22rpx 8rpx; box-sizing: border-box; }
.sheet-discard { flex: none; padding: 12rpx 22rpx 4rpx; color: #a33d36; background: #fff8f7; font-size: 21rpx; line-height: 30rpx; }
.sheet-footer { flex: none; display: flex; gap: 10rpx; padding: 8rpx 14rpx calc(12rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #edf0f4; background: #fff; }
.sheet-footer.keyboard-open { padding-bottom: 12rpx; }
.sheet-action-touch { min-width: 0; min-height: 76rpx; flex: 1; display: flex; align-items: center; justify-content: center; }
.sheet-action-visual { width: 100%; height: 62rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 13rpx; font-size: 23rpx; font-weight: 650; }
.sheet-cancel { color: #6f7c8f; background: #f2f4f7; }
.sheet-confirm { color: #fff; background: #2d70d8; }
.sheet-danger { color: #fff; background: #c33b35; }
.sheet-confirm.disabled { opacity: .55; }
