page { background: #f5f6f8; }.page { min-height: 100vh; padding: 24rpx 28rpx 70rpx; box-sizing: border-box; color: #172033; }.hero { padding: 31rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(135deg, #215ebd, #4e87e7); }.hero-title { font-size: 35rpx; font-weight: 700; }.hero-desc { margin-top: 13rpx; opacity: .82; font-size: 22rpx; line-height: 33rpx; }.section-title { margin: 41rpx 4rpx 18rpx; font-size: 30rpx; font-weight: 700; }.card, .link-card, .backup-card { padding: 25rpx; border-radius: 25rpx; background: #fff; }.link-card { display: flex; align-items: center; justify-content: space-between; }.link-card.second { margin-top: 13rpx; }.link-title { font-size: 26rpx; font-weight: 650; }.link-desc, .card-desc { margin-top: 8rpx; color: #7d8999; font-size: 21rpx; line-height: 32rpx; }.link-card > view:last-child { color: #acb4c0; font-size: 34rpx; }.chips { display: flex; flex-wrap: wrap; gap: 11rpx; margin-top: 19rpx; }.chip { display: flex; align-items: center; padding: 8rpx 12rpx 8rpx 15rpx; border-radius: 12rpx; color: #4f6d96; background: #edf4ff; font-size: 22rpx; }.remove { margin-left: 11rpx; color: #8aa2c3; font-size: 27rpx; line-height: 26rpx; }.add-row { display: flex; align-items: center; height: 76rpx; padding: 0 10rpx 0 18rpx; margin-top: 23rpx; border-radius: 16rpx; background: #f8f9fb; }.add-row input { min-width: 0; flex: 1; font-size: 23rpx; }.add-row view { padding: 13rpx 20rpx; border-radius: 13rpx; color: #fff; background: #2c70d8; font-size: 22rpx; }.password { height: 76rpx; padding: 0 18rpx; margin-top: 20rpx; border-radius: 16rpx; background: #f7f8fa; font-size: 23rpx; }.backup-summary { margin-top: 16rpx; color: #778498; font-size: 20rpx; }.backup-verified { margin-top: 10rpx; color: #3d8566; font-size: 19rpx; }.backup-actions { display: flex; gap: 12rpx; margin-top: 20rpx; }.backup-actions view { flex: 1; padding: 18rpx 8rpx; border-radius: 15rpx; color: #fff; background: #2d70d8; text-align: center; font-size: 22rpx; }.backup-actions .secondary { color: #2d6fd3; background: #edf4ff; }.restore-action { margin-top: 12rpx; }.share { margin-top: 18rpx; color: #a7662d; font-size: 20rpx; line-height: 31rpx; }.recycle-card { padding-top: 8rpx; }.recycle-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #edf0f4; }.recycle-row:last-child { border-bottom: 0; }.recycle-name { font-size: 23rpx; font-weight: 650; }.recycle-meta { margin-top: 7rpx; color: #8994a3; font-size: 18rpx; }.recycle-restore { flex: none; padding: 10rpx 14rpx; border-radius: 11rpx; color: #2d6fd3; background: #edf4ff; font-size: 20rpx; }.recycle-restore.disabled { color: #9aa2ad; background: #f0f2f5; }.recycle-empty { padding: 24rpx 0 8rpx; color: #98a0ad; text-align: center; font-size: 21rpx; }.privacy { margin: 35rpx 10rpx 0; color: #9aa2ad; font-size: 20rpx; line-height: 32rpx; text-align: center; }.icp { margin: 12rpx 10rpx 0; color: #9aa2ad; font-size: 20rpx; line-height: 32rpx; text-align: center; }.restore-snapshot { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 15rpx; margin-top: 14rpx; border-radius: 14rpx; color: #6e655b; background: #fff7ea; font-size: 19rpx; line-height: 28rpx; }.restore-snapshot view:last-child { flex: none; padding: 9rpx 11rpx; border-radius: 10rpx; color: #9a5a27; background: #ffead6; font-size: 20rpx; }.ward-card { padding: 25rpx; border: 1rpx solid #cfddf0; border-radius: 25rpx; background: linear-gradient(135deg, #fafdff, #f3f8ff); }.ward-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }.ward-title { color: #255f9d; font-size: 26rpx; font-weight: 700; }.ward-desc, .ward-note { margin-top: 8rpx; color: #71849b; font-size: 20rpx; line-height: 31rpx; }.ward-badge { flex: none; padding: 6rpx 10rpx; border-radius: 10rpx; color: #2c6cb4; background: #dfeeff; font-size: 18rpx; font-weight: 700; }.ward-picker { height: 74rpx; padding: 0 17rpx; margin-top: 20rpx; border: 1rpx solid #dae7f7; border-radius: 15rpx; color: #35699e; background: #fff; line-height: 74rpx; font-size: 23rpx; }.ward-chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 15rpx; }.ward-chip { display: flex; align-items: center; padding: 8rpx 10rpx 8rpx 14rpx; border-radius: 12rpx; color: #386795; background: #e5f0fc; font-size: 22rpx; }.ward-remove { margin-left: 10rpx; color: #6f94bd; font-size: 27rpx; line-height: 26rpx; }.ward-add { margin-top: 18rpx; background: #fff; }
/* 设置页降低装饰性留白。 */
.page { padding: 20rpx 24rpx 56rpx; }.hero { padding: 24rpx; border-radius: 22rpx; }.hero-title { font-size: 31rpx; }.section-title { margin: 30rpx 4rpx 14rpx; font-size: 28rpx; }.card, .link-card, .backup-card, .ward-card { padding: 20rpx; border-radius: 20rpx; }.link-card.second { margin-top: 10rpx; }.add-row, .password { height: 68rpx; margin-top: 16rpx; }.backup-actions { margin-top: 15rpx; }.backup-actions view { padding: 14rpx 8rpx; }.recycle-row { padding: 15rpx 0; }
