.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; background: #f5f6f8; color: #1f2937; }
.privacy { margin-bottom: 18rpx; padding: 16rpx; border-radius: 12rpx; color: #8a4b00; background: #fff5df; font-size: 24rpx; }
.card, .candidate { margin-bottom: 18rpx; padding: 24rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 2rpx 10rpx rgba(31, 41, 55, .05); }
.title { font-size: 30rpx; font-weight: 700; }.note, .details { margin-top: 12rpx; color: #667085; font-size: 25rpx; line-height: 1.6; }
.copy-button, .primary, .secondary, .confirm, .select, .edit { margin-top: 20rpx; padding: 16rpx; border-radius: 12rpx; text-align: center; font-size: 27rpx; }
.copy-button, .secondary { color: #1f5fbf; background: #edf4ff; }.primary, .confirm { color: #fff; background: #2d70d8; }.actions { display: flex; gap: 16rpx; }.actions view { flex: 1; }
.input { width: 100%; min-height: 300rpx; margin-top: 18rpx; padding: 16rpx; box-sizing: border-box; border: 1rpx solid #d0d5dd; border-radius: 12rpx; background: #fbfcfe; font-size: 25rpx; line-height: 1.5; }
.summary { margin: 22rpx 0; color: #475467; font-size: 26rpx; }.candidate-top { display: flex; justify-content: space-between; font-size: 29rpx; font-weight: 700; }.status { color: #1f5fbf; font-size: 24rpx; }.warning { margin-top: 12rpx; color: #9a6700; font-size: 24rpx; }.error { margin-top: 12rpx; color: #b42318; font-size: 24rpx; line-height: 1.5; }.blocked { border-left: 8rpx solid #d92d20; }.warning { border-left-color: #f79009; }.done { border-left-color: #12b76a; }.edit { color: #1f5fbf; background: #edf4ff; }.select { color: #667085; background: #f2f4f7; }.select.selected { color: #087443; background: #e9f9ee; }.confirm { margin: 28rpx 0 42rpx; }
.form-field, .form-picker { width: 100%; box-sizing: border-box; border-radius: 16rpx; background: #f7f8fa; font-size: 23rpx; }.form-field { height: 76rpx; padding: 0 17rpx; margin-top: 12rpx; }.form-picker { height: 74rpx; padding: 0 17rpx; margin-top: 12rpx; line-height: 74rpx; color: #4f5d70; }.required-field { position: relative; }.required-mark { position: absolute; top: 27rpx; right: 18rpx; color: #df4a43; font-size: 29rpx; line-height: 29rpx; }.unit-field.required-field .required-mark { top: 24rpx; right: 17rpx; }.two-fields, .date-row { display: flex; gap: 12rpx; }.date-row picker { min-width: 0; width: 50%; }.unit-field { min-width: 0; flex: 1; height: 76rpx; display: flex; align-items: center; padding: 0 17rpx; margin-top: 12rpx; box-sizing: border-box; border-radius: 16rpx; background: #f7f8fa; }.unit-field input { min-width: 0; flex: 1; font-size: 23rpx; }.unit-field text { color: #7c8796; font-size: 22rpx; }.choice-row { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; padding: 10rpx 12rpx 10rpx 17rpx; border-radius: 16rpx; background: #f7f8fa; }.choice-label { color: #4f5d70; font-size: 23rpx; }.choice-options { display: flex; gap: 8rpx; }.choice { min-width: 76rpx; padding: 13rpx 0; border-radius: 12rpx; color: #7c8796; background: #eceff3; text-align: center; font-size: 22rpx; }.choice.selected { color: #fff; background: #2d70d8; }.required-inline { color: #df4a43; font-size: 27rpx; line-height: 1; }
/* 导入页信息量较大，压缩卡片与按钮，不压缩原始文本输入区。 */
.page { padding: 20rpx; }.privacy { padding: 13rpx; font-size: 21rpx; }.card, .candidate { padding: 19rpx; margin-bottom: 13rpx; }.note, .details { margin-top: 8rpx; font-size: 22rpx; }.copy-button, .primary, .secondary, .confirm, .select, .edit { margin-top: 14rpx; padding: 12rpx; font-size: 23rpx; }.summary { margin: 16rpx 0; font-size: 23rpx; }.candidate-top { font-size: 26rpx; }.form-field, .unit-field { height: 68rpx; }.form-picker { height: 68rpx; line-height: 68rpx; }
