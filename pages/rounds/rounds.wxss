page { background: #f5f6f8; }.page { min-height: 100vh; padding: 24rpx 28rpx 70rpx; box-sizing: border-box; color: #172033; }
.notice { display: flex; justify-content: space-between; padding: 17rpx 20rpx; border-radius: 18rpx; color: #72829a; background: #eaf1fb; font-size: 21rpx; }.notice view, .setting { color: #276bd7; }
.heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 31rpx 4rpx 20rpx; }.title { font-size: 34rpx; font-weight: 700; }.subtitle { margin-top: 8rpx; color: #8a94a3; font-size: 21rpx; }.setting { font-size: 22rpx; }
.round-tabs { display: flex; gap: 10rpx; padding: 7rpx; margin: 0 0 18rpx; border-radius: 17rpx; background: #e9edf3; }.round-tab { flex: 1; padding: 13rpx 8rpx; border-radius: 12rpx; color: #718095; text-align: center; font-size: 22rpx; font-weight: 650; }.round-tab.selected { color: #285ea7; background: #fff; box-shadow: 0 2rpx 8rpx rgba(30,52,84,.08); }
.patient-card { width: 100%; padding: 25rpx; margin-bottom: 17rpx; box-sizing: border-box; border: 2rpx solid transparent; border-radius: 26rpx; background: #fff; overflow: hidden; }.patient-card.male { border-color: #cfe4ff; background: #fbfdff; }.patient-card.female { border-color: #ffd4e2; background: #fffdfd; }.patient-card.type-general { border-color: #315993; background: #fbfcff; }.patient-card.type-national { border-color: #d87431; background: #fffaf6; }.patient-card.type-day { border-color: #e6b51d; background: #fffdf4; }
.patient-top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.patient-labels { display: flex; min-width: 0; flex: 1; flex-wrap: wrap; align-items: center; gap: 8rpx; }.bed { font-size: 25rpx; font-weight: 700; }.patient-type { display: inline-block; padding: 3rpx 8rpx; margin-right: 0; border-radius: 8rpx; font-size: 17rpx; vertical-align: 2rpx; }.patient-type.type-general { color: #315993; background: #e7eef8; }.patient-type.type-national { color: #b75520; background: #fff0e7; }.patient-type.type-day { color: #967200; background: #fff6d7; }.patient-name { margin-top: 13rpx; }.name { font-size: 29rpx; font-weight: 700; }.age { margin-left: 12rpx; color: #8e98a6; font-size: 21rpx; }.stage { flex: none; padding: 6rpx 12rpx; border-radius: 10rpx; color: #3970ba; background: #edf4ff; font-size: 20rpx; }.meta { margin-top: 12rpx; color: #7f8a99; font-size: 21rpx; }
.clinical { display: flex; flex-wrap: wrap; gap: 9rpx; margin-top: 15rpx; }.clinical text { padding: 7rpx 11rpx; border-radius: 11rpx; color: #556c8c; background: #eef4fb; font-size: 19rpx; }
.round-focus { display: flex; flex-wrap: wrap; gap: 9rpx; margin-top: 16rpx; }.round-focus text { padding: 8rpx 11rpx; border-radius: 11rpx; font-size: 20rpx; font-weight: 650; }.round-pod { color: #6245a3; background: #f0eaff; }.round-drain { color: #2369b1; background: #e8f3ff; }
.action-title { margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #edf0f4; color: #8b95a3; font-size: 20rpx; }.actions { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }.action { padding: 11rpx 14rpx; border-radius: 13rpx; color: #2d6fd3; background: #edf4ff; font-size: 21rpx; }
.empty { padding: 80rpx 0; color: #98a0ad; text-align: center; font-size: 24rpx; }
.staff-primary { display: flex; flex-wrap: wrap; align-items: center; gap: 7rpx; margin-top: 12rpx; }.surgeon-primary, .assistant-secondary { display: inline-block; padding: 7rpx 11rpx; border-radius: 10rpx; color: #1d5db8; background: #eaf2ff; font-size: 24rpx; font-weight: 750; }.surgeon-primary text, .assistant-secondary text { margin-right: 7rpx; color: #6f82a0; font-size: 17rpx; font-weight: 650; }
.round-summary { margin-top: 12rpx; overflow: hidden; color: #56677d; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }.round-record { display: inline-flex; min-height: 64rpx; align-items: center; margin-top: 16rpx; padding: 0 14rpx; border-radius: 12rpx; color: #276bd7; background: #edf4ff; font-size: 21rpx; }.round-editor-field { color: #526276; font-size: 21rpx; }.round-editor-field textarea { width: 100%; height: 260rpx; padding: 12rpx 14rpx; box-sizing: border-box; border-radius: 14rpx; color: #243248; background: #f5f7fa; font-size: 23rpx; line-height: 32rpx; }
/* 查房列表与录入面板的紧凑规格。 */
.page { padding: 20rpx 24rpx 56rpx; }.heading { margin: 24rpx 4rpx 14rpx; }.title { font-size: 30rpx; }.patient-card { padding: 19rpx; margin-bottom: 12rpx; border-radius: 20rpx; }.patient-name { margin-top: 9rpx; }.name { font-size: 26rpx; }.staff-primary, .round-focus { margin-top: 9rpx; }.action-title { margin-top: 16rpx; padding-top: 13rpx; }.action { padding: 8rpx 11rpx; font-size: 19rpx; }.round-record { min-height: 52rpx; margin-top: 11rpx; padding: 0 11rpx; font-size: 19rpx; }.round-editor-field textarea { padding: 10rpx 12rpx; font-size: 21rpx; }
