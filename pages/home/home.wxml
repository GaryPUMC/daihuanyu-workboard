<view class="page">
  <view class="safe-top" style="height: {{navTop}}px;"></view>
  <view class="nav" style="min-height: {{navHeight}}px; padding-right: {{navRightPadding}}px;"><view><view class="nav-title">代寰宇的工作板</view><view class="nav-subtitle">{{today}} · GMT+8 北京时间</view></view></view>
  <view class="privacy-strip" bindtap="togglePrivacy"><view><view class="privacy-label">患者姓名显示</view><view class="privacy-state">{{privacyVisible ? '当前显示全名' : '当前已脱敏'}}</view></view><view class="privacy-action">{{privacyVisible ? '开启脱敏' : '显示全名'}}</view></view>
  <view class="department-card"><view><view class="department-label">当前工作科室</view><view class="department-value">{{activeDepartment}}</view></view><view class="department-actions"><picker mode="selector" range="{{departments}}" value="{{departmentIndex}}" bindchange="chooseDepartment"><view class="department-switch">切换科室</view></picker><view class="settings-entry" bindtap="goSettings">设置</view></view></view>
  <view class="medical-record-entry {{medicalRecordSummary.severe ? 'has-severe' : ''}}" bindtap="goMedicalRecords"><view><view class="medical-record-entry-title">病历书写提醒</view><view class="medical-record-entry-desc">待处理 {{medicalRecordSummary.pending}} 格 · 严重逾期 {{medicalRecordSummary.severe}} · 今日 {{medicalRecordSummary.today}} · 出院窗口 {{medicalRecordSummary.dischargeWindow}}</view></view><view class="medical-record-entry-action">进入表格 ›</view></view>
  <view class="rounds-entry" bindtap="goRounds"><view><view class="rounds-entry-title">查房 · 引流重点</view><view class="rounds-entry-desc">需记录引流 {{roundDrainCount}} 人 · 按 POD 汇报</view></view><view class="rounds-entry-action">进入查房 ›</view></view>
  <view wx:if="{{preAdmissionSummary.length}}" class="section-heading pre-admission-heading"><view class="section-title">待入院</view><view class="section-note">{{preAdmissionCount}} 人 · 床位待分配</view></view>
  <view wx:for="{{preAdmissionSummary}}" wx:key="id" class="patient-summary-card pre-admission {{item.genderClass}} {{item.patientTypeClass}}" data-id="{{item.id}}" bindtap="goPatient">
    <view class="summary-main"><view class="summary-top"><view class="summary-identity"><text class="summary-bed">{{item.locationLabel}}</text><text class="summary-name">{{item.displayName}}</text><text class="summary-age">{{item.ageSex}}</text></view><view class="summary-badges"><text class="patient-type {{item.patientTypeClass}}">{{item.patientType}}</text><text class="patient-flag pending">待入院</text></view></view><view class="summary-staff"><view class="summary-surgeon"><text>主刀</text>{{item.surgeon || '未填写'}}</view><view class="summary-assistant {{item.assistantMissing ? 'assistant-missing' : ''}}"><text>一助</text>{{item.firstAssistant || '待补'}}</view></view><view class="summary-diagnosis">{{item.diagnosis || '未填写诊断'}}</view><view class="summary-dates"><text>计划入院 {{item.admissionDate || '未填'}}</text><text>手术 {{item.surgeryDate || '未定'}}</text><text>床位 {{item.locationLabel}}</text></view></view><view class="chevron">›</view>
  </view>
  <view class="section-heading patient-heading"><view class="section-title">在院患者总览</view><view class="section-action" bindtap="goPatients">{{totalPatients}} 人 · 管理</view></view>
  <view class="patient-summary-card {{item.genderClass}} {{item.patientTypeClass}} {{item.highlightClass}}" wx:for="{{patientSummary}}" wx:key="id" data-id="{{item.id}}" bindtap="goPatient">
    <view class="summary-main"><view class="summary-top"><view class="summary-identity"><text class="summary-bed">{{item.locationLabel}}</text><text class="summary-name">{{item.displayName}}</text><text class="summary-age">{{item.ageSex}}</text></view><view class="summary-badges"><text class="patient-type {{item.patientTypeClass}}">{{item.patientType}}</text><text wx:if="{{item.hasPod}}" class="pod-badge">{{item.podText}}</text><text wx:for="{{item.alertFlags}}" wx:for-item="alert" wx:key="key" class="alert-flag {{alert.tone}}">{{alert.label}}</text></view></view><view class="today-action {{item.actionTone}}">{{item.todayAction}}</view><view class="summary-staff"><view class="summary-surgeon"><text>主刀</text>{{item.surgeon || '未填写'}}</view><view class="summary-assistant {{item.assistantMissing ? 'assistant-missing' : ''}}"><text>一助</text>{{item.firstAssistant || '待补'}}</view></view><view class="summary-diagnosis">{{item.diagnosis || '未填写诊断'}}</view><view class="summary-dates"><text>入院 {{item.admissionDate || '未填'}}</text><text>手术 {{item.surgeryDate || '未定'}}</text><text>计划出院 {{item.plannedDischargeDate || '未定'}}</text></view><view wx:if="{{item.allergyStatus === 'present'}}" class="summary-allergy has-allergy">过敏史：{{item.allergies}}</view></view><view class="chevron">›</view>
  </view>
  <view wx:if="{{patientSummary.length === 0}}" class="empty-card">当前科室暂无在院患者</view>
  <view wx:if="{{dischargedPatients.length}}" class="section-heading"><view class="section-title">出院患者</view><view class="section-note">{{dischargedCount}} 人</view></view>
  <view wx:for="{{dischargedPatients}}" wx:key="id" class="patient-summary-card discharged {{item.genderClass}} {{item.patientTypeClass}}" data-id="{{item.id}}" bindtap="goPatient">
    <view class="summary-main"><view class="summary-top"><view class="summary-identity"><text class="summary-bed">{{item.locationLabel}}</text><text class="summary-name">{{item.displayName}}</text><text class="summary-age">{{item.ageSex}}</text></view><view class="summary-badges"><text class="patient-type {{item.patientTypeClass}}">{{item.patientType}}</text><text class="patient-flag out">出院</text></view></view><view class="summary-staff"><view class="summary-surgeon"><text>主刀</text>{{item.surgeon || '未填写'}}</view><view class="summary-assistant"><text>一助</text>{{item.firstAssistant || '待补'}}</view></view><view class="summary-diagnosis">{{item.diagnosis || '未填写诊断'}}</view><view class="summary-dates"><text>入院 {{item.admissionDate || '未填'}}</text><text>手术 {{item.surgeryDate || '未定'}}</text><text>实际出院 {{item.actualDischargeDate || '未填'}}</text></view><view wx:if="{{item.allergyStatus === 'present'}}" class="summary-allergy has-allergy">过敏史：{{item.allergies}}</view></view><view class="chevron">›</view>
  </view>
  <view wx:if="{{dischargeFollowups.length}}" class="section-heading followup-heading"><view class="section-title">出院后待归档</view><view class="section-note">{{dischargeFollowups.length}} 人待处理</view></view>
  <view wx:for="{{dischargeFollowups}}" wx:key="id" class="discharge-followup-card" data-id="{{item.id}}" bindtap="goPatient"><view class="followup-top"><view class="followup-name">{{item.locationLabel}}　{{item.displayName}}</view><view class="followup-count">待 {{item.pendingCount}} 项</view></view><view class="followup-date">已于 {{item.actualDischargeDate || '未填日期'}} 出院</view><view class="followup-labels"><text wx:for="{{item.pendingLabels}}" wx:key="*this">{{item}}</text></view></view>
  <view class="section-heading"><view class="section-title">今日协作文本</view><view class="section-note">仅复制，不自动发送</view></view>
  <view class="cooperation-card"><view class="cooperation-row"><view><view class="cooperation-title">今日需拍照患者</view><view class="cooperation-desc">明日手术 · 可复制 {{todayPhotoCount}} 人</view></view><view class="cooperation-copy" data-type="photo" bindtap="previewTodayCooperation">预览并复制</view></view><view class="cooperation-row"><view><view class="cooperation-title">今日 PPT 患者</view><view class="cooperation-desc">明日手术 · 可复制 {{todayPptCount}} 人</view></view><view class="cooperation-copy" data-type="ppt" bindtap="previewTodayCooperation">预览并复制</view></view><view class="cooperation-row"><view><view class="cooperation-title">今日需放疗患者</view><view class="cooperation-desc">日间当日；普通/国疗明日 · 可复制 {{todayRadiotherapyCount}} 人</view></view><view class="cooperation-copy" data-type="radiotherapy" bindtap="previewTodayCooperation">预览并复制</view></view></view>
  <view class="section-heading"><view class="section-title">当前待办</view><view class="section-note">重要 {{overview.urgent}} · 今日 {{overview.today}}</view></view>
  <block wx:for="{{taskGroups}}" wx:for-item="group" wx:key="key">
    <view wx:if="{{group.tasks.length}}" class="group-label {{group.tone}}">{{group.title}} · {{group.tasks.length}}</view>
    <view class="task-card" wx:for="{{group.tasks}}" wx:for-item="task" wx:key="id" data-patient-id="{{task.patientId}}" bindtap="openTaskPatient">
      <view class="task-check-action" data-id="{{task.id}}" data-patient-id="{{task.patientId}}" catchtap="completeTask"><view class="task-check"></view></view><view class="task-body"><view class="task-top"><view class="patient-code">{{task.locationLabel}}　{{task.patientName}}</view><view class="tag {{task.levelClass}}">{{task.level}}</view></view><view class="task-title">{{task.title}}</view><view class="task-meta">{{task.dueText}}　·　{{task.patientCode}}</view></view><view class="chevron">›</view>
    </view>
  </block>
  <view wx:if="{{overview.overdue + overview.today + overview.upcoming === 0}}" class="empty-card">暂无未完成待办</view>
  <view class="privacy-note">【隐私】可在页面顶部切换姓名显示方式。数据仅保存在当前设备。</view>
  <wb-dialog visible="{{dialog.visible}}" title="{{dialog.title}}" message="{{dialog.message}}" confirm-text="{{dialog.confirmText}}" cancel-text="{{dialog.cancelText}}" show-cancel="{{dialog.showCancel}}" tone="{{dialog.tone}}" loading="{{dialog.loading}}" selectable="{{dialog.selectable}}" bindcancel="closeDialog" bindconfirm="confirmDialog" />
</view>
