<view class="page">
  <view class="privacy"><text>【隐私】资料仅保存在当前设备</text><view bindtap="togglePrivacy">{{privacyVisible ? '开启脱敏' : '显示全名'}}</view></view>
  <view class="department-filter"><view>当前工作科室</view><picker mode="selector" range="{{departments}}" value="{{currentDepartmentIndex}}" bindchange="chooseCurrentDepartment"><view>{{activeDepartment}}　›</view></picker></view>
  <view class="search"><text>⌕</text><input placeholder="搜索住院号、姓名、床位、诊断；可跨科室定位" value="{{query}}" bindinput="search" /></view>
  <view class="tabs"><view class="{{viewMode === 'active' ? 'active' : ''}}" data-mode="active" bindtap="switchView">在院／待入院</view><view class="{{viewMode === 'archive' ? 'active' : ''}}" data-mode="archive" bindtap="switchView">出院患者</view></view>
  <view class="toolbar"><view class="count">{{patients.length}} 位{{viewMode === 'active' ? '在院／待入院' : '出院'}}患者</view><view wx:if="{{viewMode === 'active'}}" class="add import" bindtap="goAdmissionImport">AI 导入拟入院</view><view wx:if="{{viewMode === 'active'}}" class="add" bindtap="startCreate">＋ 新增患者</view></view>

  <view wx:if="{{showForm}}" class="form-card">
    <view class="form-title">{{editingId ? '编辑患者资料' : '新增本地患者'}}</view>
    <view class="form-note">住院号、姓名等敏感信息仅保存在本机；重复住院号将被阻止。</view>
    <view wx:if="{{formIncomplete}}" class="incomplete-banner">请补全高亮字段后再保存；系统不会替你猜测缺失信息。</view>
    <view class="required-field"><input class="field {{formErrors.id ? 'field-error' : ''}}" placeholder="医院住院号 / 病案号" data-field="id" value="{{form.id}}" bindinput="input" /><text class="required-mark">*</text></view><view wx:if="{{formErrors.id}}" class="field-error-text">{{formErrors.id}}</view>
    <view class="required-field"><input class="field {{formErrors.name ? 'field-error' : ''}}" placeholder="姓名" data-field="name" value="{{form.name}}" bindinput="input" /><text class="required-mark">*</text></view><view wx:if="{{formErrors.name}}" class="field-error-text">{{formErrors.name}}</view>
    <view class="two-fields"><view class="unit-field {{formErrors.bed ? 'field-error' : ''}}"><input placeholder="{{form.admissionState === 'admitted' ? '床位数字（必填）' : '床位数字（待入院可空）'}}" type="number" data-field="bed" value="{{form.bed}}" bindinput="input" /></view><view class="unit-field"><input placeholder="年龄数字" type="number" data-field="age" value="{{form.age}}" bindinput="input" /><text>岁</text></view></view><view wx:if="{{formErrors.bed}}" class="field-error-text">{{formErrors.bed}}</view>
    <view class="choice-row {{formErrors.gender ? 'field-error' : ''}}"><view class="choice-label">性别 <text class="required-inline">*</text></view><view class="choice-options"><view wx:for="{{genders}}" wx:key="*this" class="choice {{form.gender === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="chooseGender">{{item}}</view></view></view><view wx:if="{{formErrors.gender}}" class="field-error-text">{{formErrors.gender}}</view>
    <view class="required-field"><input class="field {{formErrors.surgeon ? 'field-error' : ''}}" placeholder="主刀医生" data-field="surgeon" value="{{form.surgeon}}" bindinput="input" /><text class="required-mark">*</text></view><view wx:if="{{formErrors.surgeon}}" class="field-error-text">{{formErrors.surgeon}}</view>
    <picker mode="selector" range="{{firstAssistantOptions}}" value="{{firstAssistantIndex}}" bindchange="chooseFirstAssistant"><view class="picker">一助医生：{{firstAssistantOptions[firstAssistantIndex] || '请选择'}}　›</view></picker>
    <block wx:if="{{customAssistantMode}}"><input class="field" placeholder="填写其他一助医生" value="{{customAssistant}}" bindinput="inputCustomAssistant" /><view class="choice-row"><view class="choice-label">加入一助选择列表</view><switch checked="{{addCustomAssistantToLibrary}}" color="#2d70d8" bindchange="toggleAddCustomAssistant" /></view></block>
    <view class="choice-row {{formErrors.patientType ? 'field-error' : ''}}"><view class="choice-label">患者类型 <text class="required-inline">*</text></view><view class="choice-options"><view wx:for="{{patientTypes}}" wx:key="*this" class="choice type-choice {{form.patientType === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="choosePatientType">{{item}}</view></view></view><view wx:if="{{formErrors.patientType}}" class="field-error-text">{{formErrors.patientType}}</view>
    <view class="choice-row {{formErrors.admissionState ? 'field-error' : ''}}"><view class="choice-label">入院状态 <text class="required-inline">*</text></view><view class="choice-options"><view class="choice state-choice {{form.admissionState === 'planned' ? 'selected' : ''}}" data-value="planned" bindtap="chooseAdmissionState">待入院</view><view class="choice state-choice {{form.admissionState === 'admitted' ? 'selected' : ''}}" data-value="admitted" bindtap="chooseAdmissionState">已入院</view></view></view><view wx:if="{{formErrors.admissionState}}" class="field-error-text">{{formErrors.admissionState}}</view>
    <picker mode="selector" range="{{departments}}" value="{{departmentIndex}}" bindchange="chooseDepartment"><view class="picker {{formErrors.department ? 'field-error' : ''}}">科室：{{form.department || '请选择科室'}}　›</view></picker><view wx:if="{{formErrors.department}}" class="field-error-text">{{formErrors.department}}</view>
    <picker wx:if="{{wardOptions.length > 1}}" mode="selector" range="{{wardOptions}}" value="{{wardIndex}}" bindchange="chooseWard"><view class="picker {{formErrors.ward ? 'field-error' : ''}}">病房：{{form.ward || '选择病房'}}　›</view></picker><view wx:if="{{formErrors.ward}}" class="field-error-text">{{formErrors.ward}}</view>
    <input class="field" placeholder="诊断简称（可选）" data-field="diagnosis" value="{{form.diagnosis}}" bindinput="input" />
    <view class="choice-row allergy-choice"><view class="choice-label">过敏史</view><view class="choice-options"><view wx:for="{{allergyOptions}}" wx:key="value" class="choice {{form.allergyStatus === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="chooseAllergyStatus">{{item.label}}</view></view></view>
    <input wx:if="{{form.allergyStatus === 'present'}}" class="field" placeholder="填写过敏原及反应" data-field="allergies" value="{{form.allergies}}" bindinput="input" />
    <scroll-view wx:if="{{diagnoses.length}}" class="diagnosis-scroll" scroll-x><view class="diagnosis-options"><view wx:for="{{diagnoses}}" wx:key="*this" data-value="{{item}}" bindtap="chooseDiagnosis">{{item}}</view></view></scroll-view>
    <view class="date-row"><picker mode="date" value="{{form.admissionDate}}" bindchange="input" data-field="admissionDate"><view class="picker {{formErrors.admissionDate ? 'field-error' : ''}}">{{form.admissionState === 'planned' ? '计划入院' : form.admissionState === 'admitted' ? '实际入院' : '入院日期'}}：{{form.admissionDate || '选择'}}</view></picker><view class="date-control" wx:if="{{form.patientType !== '日间'}}"><picker mode="date" value="{{form.surgeryDate}}" bindchange="input" data-field="surgeryDate"><view class="picker {{formErrors.surgeryDate ? 'field-error' : ''}}">手术：{{form.surgeryDate || '未定'}}</view></picker><view wx:if="{{form.surgeryDate}}" class="date-clear" data-field="surgeryDate" catchtap="clearFormDate">清除</view></view><view wx:else class="picker">手术：{{form.admissionDate || '先选入院日'}}（日间同日）</view></view><view wx:if="{{formErrors.admissionDate || formErrors.surgeryDate}}" class="field-error-text">{{formErrors.admissionDate || formErrors.surgeryDate}}</view>
    <view class="date-control" wx:if="{{form.patientType !== '日间'}}"><picker mode="date" value="{{form.plannedDischargeDate}}" bindchange="input" data-field="plannedDischargeDate"><view class="picker {{formErrors.plannedDischargeDate ? 'field-error' : ''}}">计划出院：{{form.plannedDischargeDate || '未定'}}</view></picker><view wx:if="{{form.plannedDischargeDate}}" class="date-clear" data-field="plannedDischargeDate" catchtap="clearFormDate">清除</view></view><view wx:else class="picker">计划出院：{{form.admissionDate || '先选入院日'}}（日间同日）</view><view wx:if="{{formErrors.plannedDischargeDate}}" class="field-error-text">{{formErrors.plannedDischargeDate}}</view>
    <picker mode="selector" range="{{procedureOptions}}" value="{{procedureIndex}}" bindchange="chooseProcedure"><view class="picker">术式：{{procedureOptions[procedureIndex]}}　›</view></picker>
    <block wx:if="{{customProcedureMode}}"><input class="field" placeholder="填写自定义术式名称" value="{{customProcedure}}" bindinput="inputCustomProcedure" /><view class="choice-row"><view class="choice-label">纳入术式模板库</view><switch checked="{{addCustomProcedureToLibrary}}" color="#2d70d8" bindchange="toggleAddCustomProcedure" /></view></block>
    <view class="form-actions"><view bindtap="cancelForm">取消</view><view class="save" bindtap="savePatient">保存患者</view></view>
  </view>

  <view class="patient-card {{item.genderClass}} {{item.patientTypeClass}}" wx:for="{{patients}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="card-top"><view class="card-labels"><view class="bed">{{item.locationLabel}}</view><text class="patient-type {{item.patientTypeClass}}">{{item.patientType}}</text><text wx:if="{{item.listBadge}}" class="patient-list-flag">{{item.listBadge}}</text><text wx:if="{{item.needsReview}}" class="review-flag">资料待补全</text></view><view class="stage">{{item.archived ? '已归档' : item.careStatus}}</view></view>
    <view class="name">{{item.displayName}} <text>{{item.ageSex}}</text></view><view class="staff-primary"><view class="surgeon-primary"><text>主刀</text>{{item.surgeon || '未填写'}}</view><view wx:if="{{item.firstAssistant}}" class="assistant-secondary"><text>一助</text>{{item.firstAssistant}}</view></view>
    <view class="meta">{{item.displayId}}　·　{{item.department}}</view>
    <view class="diagnosis">{{item.diagnosis || '尚未填写诊断简称'}}</view>
    <view class="card-dates"><text>入院 {{item.admissionDate || '未填'}}</text><text>手术 {{item.surgeryDate || '未定'}}</text><text>计划出院 {{item.plannedDischargeDate || '未定'}}</text><text wx:if="{{item.actualDischargeDate}}">实际出院 {{item.actualDischargeDate}}</text></view>
    <view wx:if="{{item.allergyStatus === 'present'}}" class="allergy has-allergy">过敏史：{{item.allergies}}</view>
    <view wx:if="{{viewMode === 'active'}}" class="card-actions"><view class="edit" data-id="{{item.id}}" catchtap="editPatient">编辑资料</view></view>
  </view>
  <view wx:if="{{patients.length === 0}}" class="empty">{{viewMode === 'active' ? '暂无匹配的在院患者' : '尚无出院患者'}}</view>
</view>
