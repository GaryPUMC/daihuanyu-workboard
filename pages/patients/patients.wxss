page { background: #f5f6f8; }
.page { min-height: 100vh; padding: 24rpx 28rpx 70rpx; box-sizing: border-box; color: #172033; }
.privacy { display: flex; justify-content: space-between; padding: 17rpx 20rpx; border-radius: 18rpx; color: #72829a; background: #eaf1fb; font-size: 21rpx; }.privacy view { color: #276bd7; }
.department-filter { display: flex; align-items: center; justify-content: space-between; padding: 17rpx 20rpx; margin-top: 14rpx; border-radius: 18rpx; color: #6b7890; background: #fff; font-size: 22rpx; }.department-filter picker { color: #285fbb; font-weight: 650; }
.search { display: flex; align-items: center; height: 72rpx; padding: 0 20rpx; margin-top: 18rpx; border-radius: 22rpx; background: #fff; }.search text { margin-right: 12rpx; color: #9aa3b0; font-size: 28rpx; }.search input { min-width: 0; flex: 1; font-size: 24rpx; }
.tabs { display: flex; padding: 5rpx; margin-top: 18rpx; border-radius: 18rpx; background: #e9ecf1; }.tabs view { flex: 1; padding: 14rpx 0; border-radius: 14rpx; color: #7b8492; text-align: center; font-size: 23rpx; }.tabs .active { color: #1f2a3b; background: #fff; box-shadow: 0 3rpx 9rpx rgba(0,0,0,.06); font-weight: 650; }
.toolbar { display: flex; align-items: center; justify-content: space-between; margin: 27rpx 4rpx 18rpx; }.count { color: #7f8998; font-size: 23rpx; }.add { color: #286bd4; font-size: 25rpx; font-weight: 650; }
.form-card { padding: 27rpx; margin-bottom: 20rpx; border-radius: 26rpx; background: #fff; }.form-title { font-size: 29rpx; font-weight: 700; }.form-note { margin: 9rpx 0 15rpx; color: #939ba7; font-size: 20rpx; line-height: 30rpx; }.field, .picker { width: 100%; box-sizing: border-box; border-radius: 16rpx; background: #f7f8fa; font-size: 23rpx; }.field { height: 76rpx; padding: 0 17rpx; margin-top: 12rpx; }.picker { height: 74rpx; padding: 0 17rpx; margin-top: 12rpx; line-height: 74rpx; color: #4f5d70; }.two-fields, .date-row { display: flex; gap: 12rpx; }.date-row picker { min-width: 0; width: 50%; }.unit-field { min-width: 0; flex: 1; height: 76rpx; display: flex; align-items: center; padding: 0 17rpx; margin-top: 12rpx; box-sizing: border-box; border-radius: 16rpx; background: #f7f8fa; }.unit-field input { min-width: 0; flex: 1; font-size: 23rpx; }.unit-field text { color: #7c8796; font-size: 22rpx; }.choice-row { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; padding: 10rpx 12rpx 10rpx 17rpx; border-radius: 16rpx; background: #f7f8fa; }.choice-label { color: #4f5d70; font-size: 23rpx; }.choice-options { display: flex; gap: 8rpx; }.choice { min-width: 76rpx; padding: 13rpx 0; border-radius: 12rpx; color: #7c8796; background: #eceff3; text-align: center; font-size: 22rpx; }.choice.selected { color: #fff; background: #2d70d8; }
.required-field { position: relative; }.required-field .required-mark { position: absolute; top: 27rpx; right: 18rpx; color: #df4a43; font-size: 29rpx; line-height: 29rpx; }.unit-field.required-field .required-mark { top: 24rpx; right: 17rpx; color: #df4a43; font-size: 29rpx; }.required-inline { color: #df4a43; font-size: 27rpx; line-height: 1; }
.form-actions { display: flex; justify-content: flex-end; align-items: center; gap: 36rpx; margin-top: 25rpx; color: #7d8796; font-size: 25rpx; }.save { padding: 15rpx 25rpx; border-radius: 16rpx; color: #fff; background: #2d70d8; }
.staff-primary { display: flex; flex-wrap: wrap; align-items: center; gap: 7rpx; margin-top: 12rpx; }.surgeon-primary, .assistant-secondary { flex: none; padding: 8rpx 11rpx; border-radius: 11rpx; color: #1d5db8; background: #eaf2ff; font-size: 25rpx; font-weight: 750; }.surgeon-primary text, .assistant-secondary text { margin-right: 7rpx; color: #6f82a0; font-size: 17rpx; font-weight: 650; }
.diagnosis-scroll { width: 100%; margin-top: 11rpx; white-space: nowrap; }.diagnosis-options { display: flex; gap: 9rpx; }.diagnosis-options view { flex: none; padding: 7rpx 12rpx; border-radius: 10rpx; color: #58749a; background: #edf4ff; font-size: 20rpx; }
.patient-card { padding: 24rpx; margin-bottom: 16rpx; border: 2rpx solid transparent; border-radius: 24rpx; background: #fff; }.patient-card.male { border-color: #cfe4ff; background: #fbfdff; }.patient-card.female { border-color: #ffd4e2; background: #fffdfd; }.patient-card.type-general { border-color: #315993; background: #fbfcff; }.patient-card.type-national { border-color: #d87431; background: #fffaf6; }.patient-card.type-day { border-color: #e6b51d; background: #fffdf4; }.card-top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.card-labels { display: flex; min-width: 0; flex: 1; flex-wrap: wrap; align-items: center; gap: 7rpx; }.bed { font-size: 25rpx; font-weight: 650; }.patient-type { display: inline-block; padding: 3rpx 8rpx; margin-left: 0; border-radius: 8rpx; font-size: 17rpx; font-weight: 500; vertical-align: 2rpx; }.patient-type.type-general { color: #315993; background: #e7eef8; }.patient-type.type-national { color: #b75520; background: #fff0e7; }.patient-type.type-day { color: #967200; background: #fff6d7; }.stage { flex: none; padding: 5rpx 12rpx; border-radius: 10rpx; color: #3d70b7; background: #edf4ff; font-size: 20rpx; }.name { margin-top: 13rpx; font-size: 30rpx; font-weight: 650; }.name text { margin-left: 11rpx; color: #9099a7; font-size: 22rpx; font-weight: 400; }.meta, .diagnosis { margin-top: 10rpx; color: #8e97a6; font-size: 22rpx; }.diagnosis { color: #596474; }.card-actions { display: flex; justify-content: flex-end; padding-top: 13rpx; margin-top: 14rpx; border-top: 1rpx solid #edf0f4; }.edit { padding: 7rpx 11rpx; border-radius: 9rpx; color: #2c70d7; background: #edf4ff; font-size: 20rpx; }.empty { padding: 60rpx 0; text-align: center; color: #9aa1ad; font-size: 24rpx; }
.patient-list-flag { display: inline-block; min-width: 24rpx; padding: 3rpx 6rpx; margin-left: 8rpx; border-radius: 8rpx; color: #fff; background: #4f93df; text-align: center; font-size: 17rpx; font-weight: 800; vertical-align: 2rpx; }
.card-dates { display: flex; flex-wrap: wrap; gap: 9rpx; margin-top: 14rpx; }.card-dates text { padding: 5rpx 8rpx; border-radius: 8rpx; color: #607087; background: #f0f4f8; font-size: 18rpx; }.allergy { margin-top: 10rpx; color: #697789; font-size: 21rpx; }.allergy.has-allergy { padding: 10rpx 12rpx; border-radius: 11rpx; color: #a8322c; background: #fff0ed; font-size: 24rpx; font-weight: 800; }
/* 患者库采用更高密度列表，表单控件仍保留清晰可读性。 */
.incomplete-banner { padding: 13rpx 15rpx; margin: 12rpx 0 5rpx; border-radius: 13rpx; color: #a3322d; background: #fff0ed; font-size: 21rpx; line-height: 30rpx; font-weight: 650; }.field-error { border: 2rpx solid #dd4a43 !important; background: #fff7f6 !important; }.field-error-text { margin: 6rpx 5rpx 0; color: #bd332d; font-size: 19rpx; line-height: 27rpx; }.state-choice { min-width: 96rpx; }.date-control { min-width: 0; display: flex; flex: 1; align-items: center; gap: 8rpx; }.date-control picker { min-width: 0; flex: 1; }.date-clear { flex: none; margin-top: 12rpx; padding: 14rpx 10rpx; border-radius: 10rpx; color: #a4423d; background: #fff0ed; font-size: 18rpx; }.review-flag { padding: 3rpx 7rpx; border-radius: 8rpx; color: #a3322d; background: #fff0ed; font-size: 17rpx; font-weight: 700; }
.page { padding: 20rpx 24rpx 56rpx; }.search { height: 64rpx; border-radius: 18rpx; }.tabs view { padding: 11rpx 0; font-size: 21rpx; }.toolbar { margin: 21rpx 4rpx 13rpx; }.form-card { padding: 22rpx; border-radius: 22rpx; }.patient-card { padding: 18rpx; margin-bottom: 11rpx; border-radius: 20rpx; }.name { margin-top: 9rpx; font-size: 27rpx; }.meta, .diagnosis { margin-top: 7rpx; font-size: 20rpx; }.card-actions { padding-top: 9rpx; margin-top: 10rpx; }.edit { padding: 6rpx 10rpx; font-size: 19rpx; }.card-dates { margin-top: 10rpx; }
