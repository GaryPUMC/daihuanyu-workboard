<view class="page">
  <view class="privacy-strip" bindtap="togglePrivacy"><view><view class="privacy-title">【隐私】患者姓名显示</view><view class="privacy-state">{{privacyVisible ? '当前显示全名' : '当前已脱敏'}}</view></view><view class="privacy-action">{{privacyVisible ? '开启脱敏' : '显示全名'}}</view></view>

  <view class="heading"><view><view class="title">病历书写提醒</view><view class="subtitle">{{activeDepartment}} · {{today}}</view></view><view class="pending-total">{{summary.pending}} 项待处理</view></view>

  <view class="summary-panel {{summary.severe ? 'has-severe' : ''}}">
    <view wx:if="{{summary.pending}}" class="summary-primary">{{summary.pending}} 项尚未确认</view>
    <view wx:else class="summary-primary">当前均已确认</view>
    <view class="summary-items"><text>严重逾期 {{summary.severe}}</text><text>全部逾期 {{summary.overdue}}</text><text>今日 {{summary.today}}</text><text>出院窗口 {{summary.dischargeWindow}}</text></view>
  </view>

  <view class="view-tabs"><view class="view-tab {{viewMode === 'active' ? 'selected' : ''}}" data-mode="active" bindtap="selectViewMode">在院患者</view><view class="view-tab {{viewMode === 'pending' ? 'selected' : ''}}" data-mode="pending" bindtap="selectViewMode">仅看未写</view><view class="view-tab {{viewMode === 'discharged' ? 'selected' : ''}}" data-mode="discharged" bindtap="selectViewMode">出院待补</view></view>

  <view class="notice">未点击仅表示本机尚未确认，不代表院内病历一定缺失；请以院内正式病历为准。</view>

  <view class="list-toolbar"><view>患者病历节点</view><view class="patient-count">{{patients.length}} 人</view></view>

  <view class="record-viewport">
    <scroll-view wx:if="{{patients.length}}" class="record-scroll" scroll-y="true" enhanced="true" show-scrollbar="true">
      <view class="patient-list">
        <view class="patient-card {{patient.maxOverdueDays >= 7 ? 'severe-patient' : ''}} {{patient.completedJustNow ? 'completed-just-now' : ''}}" wx:for="{{patients}}" wx:for-item="patient" wx:key="id">
          <view class="patient-summary" data-patient-id="{{patient.id}}" bindtap="togglePatientTimeline">
            <view class="patient-header">
              <view class="patient-identity"><view class="patient-location">{{patient.locationLabel}}</view><view class="patient-name">{{patient.displayName}}</view><view class="patient-pod">{{patient.podText}}</view></view>
              <view class="patient-header-meta"><view class="pending-badge {{patient.pendingCount ? 'has-pending' : ''}}">{{patient.pendingCount ? patient.pendingCount + ' 项未写' : '已写完'}}</view><view class="row-chevron">{{patient.expanded ? '⌃' : '›'}}</view></view>
            </view>
            <view class="patient-work">
              <view wx:if="{{patient.pendingCount}}" class="pending-chips">
                <view wx:for="{{patient.pendingCells}}" wx:for-item="cell" wx:key="requirementKey" class="record-chip {{cell.status}}" hover-class="cell-pressed" data-patient-id="{{patient.id}}" data-requirement-key="{{cell.requirementKey}}" data-done="{{cell.done}}" data-actionable="{{cell.actionable}}" catchtap="toggleRequirement"><text>{{cell.nodeLabel}}</text><text>{{cell.displayDate}} · {{cell.compactStatusText}}</text></view>
              </view>
              <view wx:elif="{{patient.completedJustNow}}" class="all-done recent">刚完成全部待补 · 可展开撤销</view>
              <view wx:else class="all-done">当前已写</view>
              <view class="next-node"><text>下次</text><text>{{patient.nextCell ? patient.nextCell.displayDate : '—'}}</text><text>{{patient.nextCell ? patient.nextCell.nodeLabel : '暂无计划节点'}}</text></view>
            </view>
          </view>

          <view wx:if="{{patient.expanded}}" class="patient-timeline">
            <view class="timeline-heading"><text>全部节点</text><text>日期由新到旧</text></view>
            <view class="timeline-row" wx:for="{{patient.timeline}}" wx:for-item="cell" wx:key="requirementKey">
              <view class="timeline-date">{{cell.displayDate}}</view>
              <view class="timeline-node"><view>{{cell.nodeLabel}}</view><text wx:if="{{cell.linkedDischarge}}">同时满足出院病历</text></view>
              <view class="timeline-status {{cell.status}} {{cell.actionable ? 'actionable' : ''}}" hover-class="{{cell.actionable ? 'cell-pressed' : 'none'}}" data-patient-id="{{patient.id}}" data-requirement-key="{{cell.requirementKey}}" data-done="{{cell.done}}" data-actionable="{{cell.actionable}}" catchtap="toggleRequirement"><text>{{cell.statusText}}</text><text wx:if="{{cell.actionable}}">{{cell.actionLabel}}</text></view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view wx:else class="empty">{{viewMode === 'discharged' ? '暂无出院后待补病历' : viewMode === 'pending' ? '当前没有待处理病历' : '当前科室暂无术后在院患者'}}</view>
  </view>

  <view class="legend"><view><text class="legend-swatch severe"></text>严重逾期≥7天</view><view><text class="legend-swatch warning"></text>一般逾期</view><view><text class="legend-swatch today"></text>今日应写</view><view><text class="legend-swatch window"></text>出院窗口</view><view><text class="legend-swatch done"></text>已经完成</view></view>
  <view class="operation-note">主列表完整展示全部未写节点；点击患者可查看已写记录及最近下次节点。患者始终按病房、床位稳定排列。</view>
</view>
