page { background: #f5f6f8; color: #172033; }
.page { min-height: 100vh; padding: 20rpx 24rpx 60rpx; box-sizing: border-box; }
.privacy-strip { display: flex; min-height: 70rpx; padding: 9rpx 10rpx 9rpx 15rpx; box-sizing: border-box; align-items: center; justify-content: space-between; border: 1rpx solid #dbe7f7; border-radius: 15rpx; background: #edf4fd; }
.privacy-title { color: #3d4c61; font-size: 20rpx; font-weight: 650; }.privacy-state { margin-top: 2rpx; color: #7c899b; font-size: 18rpx; }.privacy-action { display: flex; min-height: 50rpx; padding: 0 12rpx; align-items: center; border-radius: 10rpx; color: #276bd7; background: #fff; font-size: 19rpx; font-weight: 700; }
.heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; margin: 24rpx 4rpx 14rpx; }.title { font-size: 31rpx; font-weight: 700; }.subtitle { margin-top: 5rpx; color: #8792a2; font-size: 19rpx; }.pending-total { flex: none; color: #a6312c; font-size: 21rpx; font-weight: 700; }
.summary-panel { padding: 17rpx 19rpx; border-radius: 18rpx; color: #255d43; background: #e8f5ed; }.summary-panel.has-severe { color: #fff; background: linear-gradient(135deg, #a83731, #d25d50); box-shadow: 0 8rpx 20rpx rgba(168,55,49,.16); }.summary-primary { font-size: 27rpx; font-weight: 750; }.summary-items { display: flex; flex-wrap: wrap; gap: 8rpx 16rpx; margin-top: 8rpx; font-size: 18rpx; opacity: .88; }
.view-tabs { display: flex; gap: 8rpx; padding: 6rpx; margin-top: 14rpx; border-radius: 15rpx; background: #e8edf3; }.view-tab { flex: 1; padding: 12rpx 5rpx; border-radius: 11rpx; color: #6c7a8e; text-align: center; font-size: 20rpx; font-weight: 650; }.view-tab.selected { color: #285ea7; background: #fff; box-shadow: 0 2rpx 8rpx rgba(30,52,84,.08); }
.notice { margin: 13rpx 3rpx 10rpx; color: #7b8797; font-size: 18rpx; line-height: 28rpx; }
.record-scroll { width: 100%; border: 1rpx solid #dfe4eb; border-radius: 17rpx; background: #fff; box-shadow: 0 3rpx 12rpx rgba(28,43,69,.04); }
.record-table { min-width: 100%; }.record-row { display: flex; width: 100%; min-height: 104rpx; border-bottom: 1rpx solid #edf0f4; }.record-row:last-child { border-bottom: 0; }.record-row.header-row { min-height: 72rpx; }
.patient-column { position: sticky; left: 0; z-index: 2; width: 176rpx; flex: none; box-sizing: border-box; border-right: 1rpx solid #e3e7ed; background: #fbfcfd; }.pod-column { width: 104rpx; flex: none; box-sizing: border-box; border-right: 1rpx solid #edf0f4; }.discharge-column { width: 124rpx; flex: none; box-sizing: border-box; }
.header-cell { display: flex; z-index: 3; align-items: center; justify-content: center; color: #667487; background: #eef2f6; font-size: 18rpx; font-weight: 700; }.patient-cell { padding: 12rpx 10rpx; }.patient-cell.severe-patient { box-shadow: inset 6rpx 0 0 #a72f2b; }.patient-location { overflow: hidden; color: #4d5b6f; text-overflow: ellipsis; white-space: nowrap; font-size: 19rpx; font-weight: 700; }.patient-name { margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 22rpx; font-weight: 700; }.patient-pod { margin-top: 4rpx; color: #6952a2; font-size: 17rpx; font-weight: 650; }
.body-cell { display: flex; padding: 7rpx 5rpx; align-items: center; justify-content: center; }.record-cell { display: flex; width: 88rpx; min-height: 78rpx; padding: 6rpx 2rpx; box-sizing: border-box; align-items: center; justify-content: center; flex-direction: column; border-radius: 10rpx; color: #929ba8; background: #f0f2f5; }.cell-date { font-size: 17rpx; }.cell-status { margin-top: 4rpx; font-size: 17rpx; font-weight: 750; }.record-cell.actionable { box-shadow: inset 0 0 0 1rpx rgba(0,0,0,.04); }
.record-cell.severe { color: #fff; background: #a8322c; }.record-cell.overdue { color: #a8322c; background: #ffdfdc; }.record-cell.warning { color: #a05e1f; background: #fff0dd; }.record-cell.today { color: #1f62aa; background: #dcecff; }.record-cell.window, .record-cell.linked { color: #6849a9; background: #ede5ff; }.record-cell.done { color: #236a47; background: #dff2e7; }.record-cell.future, .record-cell.not-applicable { color: #9aa2ad; background: #f0f2f5; }.discharge-cell { width: 108rpx; }
.legend { display: flex; flex-wrap: wrap; gap: 10rpx 17rpx; margin: 17rpx 5rpx 0; color: #748092; font-size: 17rpx; }.legend view { display: flex; align-items: center; }.legend-swatch { width: 14rpx; height: 14rpx; margin-right: 6rpx; border-radius: 4rpx; }.legend-swatch.severe { background: #a8322c; }.legend-swatch.warning { background: #e19a4f; }.legend-swatch.today { background: #65a0df; }.legend-swatch.window { background: #8c72c7; }.legend-swatch.done { background: #55a176; }
.operation-note { margin: 15rpx 5rpx 0; padding: 13rpx 15rpx; border-radius: 13rpx; color: #607086; background: #eaf0f7; font-size: 18rpx; line-height: 29rpx; }.empty { padding: 70rpx 20rpx; color: #929ba8; text-align: center; font-size: 22rpx; }
