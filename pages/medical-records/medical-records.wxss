page { height: 100%; overflow: hidden; background: #f5f6f8; color: #172033; }
.page { display: flex; height: 100vh; min-height: 0; padding: 16rpx 22rpx 20rpx; overflow: hidden; box-sizing: border-box; flex-direction: column; }
.privacy-strip, .heading, .summary-panel, .view-tabs, .notice { flex: none; }
.privacy-strip { display: flex; min-height: 66rpx; padding: 8rpx 10rpx 8rpx 14rpx; box-sizing: border-box; align-items: center; justify-content: space-between; border: 1rpx solid #dbe7f7; border-radius: 14rpx; background: #edf4fd; }
.privacy-title { color: #3d4c61; font-size: 19rpx; font-weight: 650; }.privacy-state { margin-top: 2rpx; color: #7c899b; font-size: 17rpx; }.privacy-action { display: flex; min-height: 46rpx; padding: 0 11rpx; align-items: center; border-radius: 9rpx; color: #276bd7; background: #fff; font-size: 18rpx; font-weight: 700; }
.heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 14rpx; margin: 20rpx 3rpx 12rpx; }.title { font-size: 29rpx; font-weight: 700; }.subtitle { margin-top: 4rpx; color: #8792a2; font-size: 18rpx; }.pending-total { flex: none; color: #a6312c; font-size: 20rpx; font-weight: 700; }
.summary-panel { padding: 14rpx 17rpx; border-radius: 16rpx; color: #255d43; background: #e8f5ed; }.summary-panel.has-severe { color: #fff; background: linear-gradient(135deg, #a83731, #d25d50); box-shadow: 0 7rpx 18rpx rgba(168,55,49,.16); }.summary-primary { font-size: 25rpx; font-weight: 750; }.summary-items { display: flex; flex-wrap: wrap; gap: 7rpx 14rpx; margin-top: 7rpx; font-size: 17rpx; opacity: .88; }
.view-tabs { display: flex; gap: 7rpx; padding: 5rpx; margin-top: 12rpx; border-radius: 14rpx; background: #e8edf3; }.view-tab { flex: 1; padding: 10rpx 4rpx; border-radius: 10rpx; color: #6c7a8e; text-align: center; font-size: 19rpx; font-weight: 650; }.view-tab.selected { color: #285ea7; background: #fff; box-shadow: 0 2rpx 8rpx rgba(30,52,84,.08); }
.notice { margin: 9rpx 3rpx 7rpx; color: #7b8797; font-size: 16rpx; line-height: 23rpx; }
.list-toolbar { display: flex; flex: none; margin-bottom: 7rpx; align-items: center; justify-content: space-between; color: #536176; font-size: 18rpx; font-weight: 700; }.patient-count { color: #667487; font-size: 17rpx; font-weight: 650; }
.record-viewport { width: 100%; min-height: 240rpx; overflow: hidden; box-sizing: border-box; flex: 1; border: 1rpx solid #dfe4eb; border-radius: 16rpx; background: #fff; box-shadow: 0 3rpx 12rpx rgba(28,43,69,.04); }
.record-scroll { width: 100%; height: 100%; }.patient-list { width: 100%; }.patient-card { border-bottom: 1rpx solid #edf0f4; background: #fff; }.patient-card:last-child { border-bottom: 0; }.patient-card.severe-patient { box-shadow: inset 6rpx 0 0 #a72f2b; }.patient-card.completed-just-now { background: #f4fbf7; }
.patient-summary { min-height: 104rpx; padding: 10rpx 12rpx 11rpx 15rpx; box-sizing: border-box; }.patient-header { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 10rpx; }.patient-identity { display: flex; min-width: 0; align-items: baseline; gap: 8rpx; flex: 1; }.patient-location { max-width: 172rpx; overflow: hidden; flex: none; color: #4d5b6f; text-overflow: ellipsis; white-space: nowrap; font-size: 16rpx; font-weight: 700; }.patient-name { min-width: 0; overflow: hidden; flex: 1; text-overflow: ellipsis; white-space: nowrap; font-size: 21rpx; font-weight: 720; }.patient-pod { flex: none; color: #6952a2; font-size: 16rpx; font-weight: 650; }.patient-header-meta { display: flex; flex: none; align-items: center; gap: 7rpx; }.pending-badge { padding: 3rpx 7rpx; border-radius: 7rpx; color: #2f7552; background: #e4f3ea; font-size: 14rpx; font-weight: 720; }.pending-badge.has-pending { color: #9b332e; background: #ffebe8; }
.patient-work { min-width: 0; }.pending-chips { display: flex; min-width: 0; margin-top: 8rpx; flex-wrap: wrap; gap: 6rpx; }.record-chip { display: flex; min-width: 132rpx; max-width: 190rpx; min-height: 50rpx; padding: 4rpx 8rpx; box-sizing: border-box; align-items: flex-start; justify-content: center; flex: 1 1 132rpx; flex-direction: column; border-radius: 8rpx; font-size: 15rpx; font-weight: 720; line-height: 19rpx; }.record-chip text:last-child { font-size: 14rpx; font-weight: 650; opacity: .92; }.all-done { margin-top: 7rpx; color: #337455; font-size: 16rpx; font-weight: 700; }.all-done.recent { color: #28704d; font-size: 15rpx; line-height: 22rpx; }
.next-node { display: flex; min-width: 0; margin-top: 7rpx; align-items: center; gap: 7rpx; color: #8994a3; font-size: 14rpx; line-height: 19rpx; }.next-node text:nth-child(2) { color: #34445b; font-size: 16rpx; font-weight: 750; }.next-node text:last-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.row-chevron { width: 22rpx; flex: none; color: #98a2b0; text-align: center; font-size: 27rpx; }
.patient-timeline { padding: 0 11rpx 11rpx 13rpx; background: #f7f9fc; }.timeline-heading { display: flex; padding: 9rpx 4rpx 7rpx; align-items: center; justify-content: space-between; color: #657286; font-size: 16rpx; font-weight: 700; }.timeline-row { display: flex; min-height: 62rpx; padding: 6rpx 7rpx; box-sizing: border-box; align-items: center; gap: 8rpx; border-top: 1rpx solid #e7ebf0; }.timeline-date { width: 92rpx; flex: none; color: #34445b; font-size: 18rpx; font-weight: 730; }.timeline-node { min-width: 0; flex: 1; color: #445268; font-size: 17rpx; font-weight: 680; }.timeline-node text { display: block; margin-top: 2rpx; color: #7d6aa7; font-size: 14rpx; font-weight: 600; }.timeline-status { display: flex; width: 102rpx; min-height: 46rpx; padding: 4rpx 5rpx; box-sizing: border-box; align-items: center; justify-content: center; flex-direction: column; border-radius: 8rpx; color: #929ba8; background: #eef1f4; text-align: center; font-size: 14rpx; font-weight: 720; line-height: 18rpx; }.timeline-status text + text { font-size: 13rpx; opacity: .88; }
.record-chip.severe, .timeline-status.severe { color: #fff; background: #a8322c; }.record-chip.overdue, .timeline-status.overdue { color: #a8322c; background: #ffdfdc; }.record-chip.warning, .timeline-status.warning { color: #a05e1f; background: #fff0dd; }.record-chip.today, .timeline-status.today { color: #1f62aa; background: #dcecff; }.record-chip.window, .record-chip.linked, .timeline-status.window, .timeline-status.linked { color: #6849a9; background: #ede5ff; }.record-chip.done, .timeline-status.done { color: #236a47; background: #dff2e7; }.record-chip.future, .timeline-status.future { color: #8f99a6; background: #eef1f4; }.cell-pressed { opacity: .68; transform: scale(.96); }
.legend { display: flex; flex: none; flex-wrap: wrap; gap: 7rpx 13rpx; margin: 10rpx 4rpx 0; color: #748092; font-size: 15rpx; }.legend view { display: flex; align-items: center; }.legend-swatch { width: 12rpx; height: 12rpx; margin-right: 5rpx; border-radius: 4rpx; }.legend-swatch.severe { background: #a8322c; }.legend-swatch.warning { background: #e19a4f; }.legend-swatch.today { background: #65a0df; }.legend-swatch.window { background: #8c72c7; }.legend-swatch.done { background: #55a176; }
.operation-note { flex: none; margin: 9rpx 4rpx 0; padding: 8rpx 11rpx; border-radius: 10rpx; color: #607086; background: #eaf0f7; font-size: 15rpx; line-height: 22rpx; }.empty { display: flex; width: 100%; height: 100%; padding: 20rpx; box-sizing: border-box; align-items: center; justify-content: center; color: #929ba8; text-align: center; font-size: 21rpx; }
