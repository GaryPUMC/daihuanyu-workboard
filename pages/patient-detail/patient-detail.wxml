<view class="page" wx:if="{{patient}}">
  <view class="privacy-row"><view>{{archived ? '出院归档 · 只读' : '本地患者资料'}}</view><view class="privacy-actions"><view wx:if="{{!archived}}" class="edit-link" bindtap="startEdit">编辑资料</view><view class="mask" bindtap="togglePrivacy">{{privacyVisible ? '开启脱敏' : '显示全名'}}</view></view></view>
  <view class="identity-card {{patient.genderClass}} {{patient.patientTypeClass}}">
    <view class="identity-top"><view class="bed">{{patient.locationLabel}} <text class="patient-type {{patient.patientTypeClass}}">{{patient.patientType}}</text></view><view class="stage">{{archived ? '已归档' : patient.careStatus}}</view></view>
    <view class="identity-major"><view class="identity-name">{{patient.displayName}} <text>{{patient.ageSex}}</text></view><view wx:if="{{patient.surgeon}}" class="identity-surgeon"><text>主刀</text>{{patient.surgeon}}</view><view wx:if="{{patient.firstAssistant}}" class="identity-assistant"><text>一助</text>{{patient.firstAssistant}}</view></view>
    <view class="identity-id">住院号：{{patient.displayId}}</view>
    <view class="identity-meta">{{patient.department}}　·　{{patient.diagnosis || '未填写诊断简称'}}</view>
    <view wx:if="{{patient.needsReview}}" class="review-banner">资料未完整，请进入“编辑资料”补全高亮字段。</view>
    <view class="identity-dates"><text>入院　{{patient.admissionDate || '未填'}}</text><text>手术　{{patient.surgeryDate || '未定'}}</text><text>计划出院　{{patient.plannedDischargeDate || '未定'}}</text><text wx:if="{{patient.actualDischargeDate}}">实际出院　{{patient.actualDischargeDate}}</text></view>
    <view wx:if="{{patient.careStatus === '待入院'}}" class="pre-admission-note">预入院患者：预计 {{patient.admissionDate}} 入院，床位 {{patient.bedDisplay}}；入院后可在“编辑资料”补充床位并纳入在院工作。</view>
    <view wx:if="{{!archived && patient.careStatus === '在院'}}" class="discharge-inline"><picker wx:if="{{patient.patientType !== '日间'}}" mode="date" value="{{dischargeDateInput}}" bindchange="chooseDischargeDate"><view class="discharge-date">出院日期：{{dischargeDateInput || '选择日期'}}　›</view></picker><view wx:else class="discharge-date">出院日期：{{patient.admissionDate || '请先补充入院日期'}}（日间同日）</view><view class="discharge-action" bindtap="discharge">确认出院</view></view>
    <view wx:if="{{patient.allergyStatus === 'present'}}" class="identity-allergy has-allergy">过敏史：{{patient.allergies}}</view>
    <view class="condition-row" wx:if="{{patient.conditions.length}}"><text wx:for="{{patient.conditions}}" wx:key="*this">{{item}}</text></view>
    <view class="surgery" wx:if="{{patient.surgeryDate}}"><view><text>手术日期</text>{{patient.surgeryDate}}</view><view><text>相对手术日</text>{{patient.podText}}</view><view class="surgery-wide"><text>拟行术式</text><view>{{patient.surgeryName || '未填写'}}</view></view><view class="surgery-wide"><text>正式术式</text><view>{{patient.surgeryNameConfirmed ? patient.confirmedSurgeryName : '待与主刀确认'}}</view></view></view>
  </view>
  <view wx:if="{{editing}}" class="edit-card">
    <view class="edit-title">编辑患者</view>
    <view class="edit-note">红色 * 为必填项；所有修改仅保存在当前设备。</view>
    <view wx:if="{{editIncomplete}}" class="review-banner">请补全红色高亮字段后再保存；系统不会自动猜测未知信息。</view>
    <view class="edit-group-title">基本信息</view>
    <view class="edit-field"><view>住院号 <text>*</text></view><input class="{{editErrors.id ? 'edit-field-error' : ''}}" data-field="id" value="{{editForm.id}}" bindinput="inputEdit" /><view wx:if="{{editErrors.id}}" class="edit-error-text">{{editErrors.id}}</view></view>
    <view class="edit-field"><view>姓名 <text>*</text></view><input class="{{editErrors.name ? 'edit-field-error' : ''}}" data-field="name" value="{{editForm.name}}" bindinput="inputEdit" /><view wx:if="{{editErrors.name}}" class="edit-error-text">{{editErrors.name}}</view></view>
    <view class="edit-two"><view class="edit-field"><view>床位（已入院必填）</view><input class="{{editErrors.bed ? 'edit-field-error' : ''}}" type="number" data-field="bed" value="{{editForm.bed}}" bindinput="inputEdit" /><view wx:if="{{editErrors.bed}}" class="edit-error-text">{{editErrors.bed}}</view></view><view class="edit-field"><view>年龄</view><input type="number" data-field="age" value="{{editForm.age}}" bindinput="inputEdit" /></view></view>
    <view class="edit-choice {{editErrors.gender ? 'edit-field-error' : ''}}"><view>性别 <text>*</text></view><view class="edit-options"><view wx:for="{{genders}}" wx:key="*this" class="edit-option {{editForm.gender === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="chooseEditGender">{{item}}</view></view></view><view wx:if="{{editErrors.gender}}" class="edit-error-text">{{editErrors.gender}}</view>
    <view class="edit-field"><view>主刀医生 <text>*</text></view><input class="{{editErrors.surgeon ? 'edit-field-error' : ''}}" data-field="surgeon" value="{{editForm.surgeon}}" bindinput="inputEdit" /><view wx:if="{{editErrors.surgeon}}" class="edit-error-text">{{editErrors.surgeon}}</view></view>
    <picker mode="selector" range="{{firstAssistantOptions}}" value="{{firstAssistantIndex}}" bindchange="chooseEditFirstAssistant"><view class="edit-picker">一助医生：{{firstAssistantOptions[firstAssistantIndex] || '请选择'}}　›</view></picker>
    <block wx:if="{{customAssistantMode}}"><view class="edit-field"><view>其他一助医生</view><input value="{{customAssistant}}" placeholder="填写一助医生姓名" bindinput="inputEditCustomAssistant" /></view><view class="choice-row"><view class="choice-label">加入一助选择列表</view><switch checked="{{addCustomAssistantToLibrary}}" color="#2d70d8" bindchange="toggleEditCustomAssistantLibrary" /></view></block>
    <view class="edit-choice {{editErrors.patientType ? 'edit-field-error' : ''}}"><view>患者类型 <text>*</text></view><view class="edit-options"><view wx:for="{{patientTypes}}" wx:key="*this" class="edit-option {{editForm.patientType === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="chooseEditType">{{item}}</view></view></view><view wx:if="{{editErrors.patientType}}" class="edit-error-text">{{editErrors.patientType}}</view>
    <view class="edit-choice {{editErrors.admissionState ? 'edit-field-error' : ''}}"><view>入院状态 <text>*</text></view><view class="edit-options"><view class="edit-option state-option {{editForm.admissionState === 'planned' ? 'selected' : ''}}" data-value="planned" bindtap="chooseEditAdmissionState">待入院</view><view class="edit-option state-option {{editForm.admissionState === 'admitted' ? 'selected' : ''}}" data-value="admitted" bindtap="chooseEditAdmissionState">已入院</view></view></view><view wx:if="{{editErrors.admissionState}}" class="edit-error-text">{{editErrors.admissionState}}</view>
    <picker mode="selector" range="{{departments}}" value="{{departmentIndex}}" bindchange="chooseEditDepartment"><view class="edit-picker {{editErrors.department ? 'edit-field-error' : ''}}">科室：{{editForm.department || '请选择科室'}}　›</view></picker><view wx:if="{{editErrors.department}}" class="edit-error-text">{{editErrors.department}}</view>
    <picker wx:if="{{wardOptions.length > 1}}" mode="selector" range="{{wardOptions}}" value="{{wardIndex}}" bindchange="chooseEditWard"><view class="edit-picker {{editErrors.ward ? 'edit-field-error' : ''}}">病房：{{editForm.ward || '选择病房'}}　›</view></picker><view wx:if="{{editErrors.ward}}" class="edit-error-text">{{editErrors.ward}}</view>
    <view class="edit-group-title">医疗信息</view>
    <view class="edit-field"><view>诊断简称</view><input data-field="diagnosis" value="{{editForm.diagnosis}}" bindinput="inputEdit" /></view>
    <view class="edit-choice allergy-choice"><view>过敏史</view><view class="edit-options"><view wx:for="{{allergyOptions}}" wx:key="value" class="edit-option {{editForm.allergyStatus === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="chooseEditAllergyStatus">{{item.label}}</view></view></view>
    <view wx:if="{{editForm.allergyStatus === 'present'}}" class="edit-field"><view>过敏原及反应</view><input class="{{editErrors.allergies ? 'edit-field-error' : ''}}" data-field="allergies" value="{{editForm.allergies}}" placeholder="请填写" bindinput="inputEdit" /><view wx:if="{{editErrors.allergies}}" class="edit-error-text">{{editErrors.allergies}}</view></view>
    <view wx:if="{{conditionOptions.length}}" class="edit-field"><view>特殊标记</view><view class="edit-condition-options"><view wx:for="{{conditionOptions}}" wx:key="value" class="edit-condition {{item.selected ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="toggleEditCondition">{{item.value}}</view></view></view>
    <view class="edit-group-title">手术与住院信息</view>
    <picker mode="date" value="{{editForm.admissionDate}}" data-field="admissionDate" bindchange="inputEdit"><view class="edit-picker {{editErrors.admissionDate ? 'edit-field-error' : ''}}">{{editForm.admissionState === 'planned' ? '计划入院' : editForm.admissionState === 'admitted' ? '实际入院' : '入院日期'}}：{{editForm.admissionDate || '选择'}}</view></picker><view wx:if="{{editErrors.admissionDate}}" class="edit-error-text">{{editErrors.admissionDate}}</view>
    <view wx:if="{{editForm.patientType !== '日间'}}" class="edit-date-control"><picker mode="date" value="{{editForm.surgeryDate}}" data-field="surgeryDate" bindchange="inputEdit"><view class="edit-picker {{editErrors.surgeryDate ? 'edit-field-error' : ''}}">手术：{{editForm.surgeryDate || '未定'}}</view></picker><view wx:if="{{editForm.surgeryDate}}" class="edit-date-clear" data-field="surgeryDate" bindtap="clearEditDate">清除</view></view><view wx:else class="edit-picker">手术：{{editForm.admissionDate || '先选入院日'}}（日间同日）</view><view wx:if="{{editErrors.surgeryDate}}" class="edit-error-text">{{editErrors.surgeryDate}}</view>
    <view wx:if="{{editForm.patientType !== '日间'}}" class="edit-date-control"><picker mode="date" value="{{editForm.plannedDischargeDate}}" data-field="plannedDischargeDate" bindchange="inputEdit"><view class="edit-picker {{editErrors.plannedDischargeDate ? 'edit-field-error' : ''}}">计划出院：{{editForm.plannedDischargeDate || '未定'}}</view></picker><view wx:if="{{editForm.plannedDischargeDate}}" class="edit-date-clear" data-field="plannedDischargeDate" bindtap="clearEditDate">清除</view></view><view wx:else class="edit-picker">计划出院：{{editForm.admissionDate || '先选入院日'}}（日间同日）</view><view wx:if="{{editErrors.plannedDischargeDate}}" class="edit-error-text">{{editErrors.plannedDischargeDate}}</view>
    <picker mode="selector" range="{{procedureOptions}}" value="{{procedureIndex}}" bindchange="chooseEditProcedure"><view class="edit-picker">拟行术式：{{procedureOptions[procedureIndex] || '选择术式'}}　›</view></picker>
    <block wx:if="{{customProcedureMode}}"><view class="edit-field procedure-field"><view>自定义术式</view><textarea value="{{customProcedure}}" placeholder="填写完整术式名称" maxlength="-1" auto-height bindinput="inputEditCustomProcedure" /></view><view class="choice-row"><view class="choice-label">纳入术式模板库</view><switch checked="{{addCustomProcedureToLibrary}}" color="#2d70d8" bindchange="toggleEditCustomProcedureLibrary" /></view></block>
    <view class="edit-actions"><view bindtap="cancelEdit">取消</view><view class="save-edit" bindtap="saveEdit">保存修改</view></view>
  </view>
  <view wx:if="{{revisionEvents.length}}" class="revision-card"><view class="revision-title">最近资料修改</view><view class="revision-note">自动留痕，不要求填写修改理由</view><view wx:for="{{revisionEvents}}" wx:key="id" class="revision-row"><view class="revision-time">{{item.timeText}}</view><view class="revision-detail">{{item.note}}</view></view></view>

  <view wx:if="{{patient.surgeryConfirmation}}" class="heading"><view class="section-title">术前核查</view><view class="task-count">仅记录正式术式确认，不推进流程</view></view>
  <view wx:if="{{patient.surgeryConfirmation}}" class="checklist-card">
    <view class="checklist-item" bindtap="openSurgeryNameConfirm"><view class="check {{patient.surgeryConfirmation.done ? 'checked' : ''}}">{{patient.surgeryConfirmation.done ? '✓' : ''}}</view><view><view class="checklist-title {{patient.surgeryConfirmation.done ? 'done' : ''}}">与主刀确认正式术式</view><view class="confirm-task-note">{{patient.surgeryConfirmation.confirmedSurgeryName ? '正式术式：' + patient.surgeryConfirmation.confirmedSurgeryName : '点击录入确认后的正式术式名称'}}</view></view></view>
  </view>

  <view wx:if="{{appointmentTypes.length}}" class="heading"><view class="section-title">协作文本</view><view class="task-count">仅复制，不自动发送</view></view>
  <view wx:if="{{appointmentTypes.length}}" class="appointment-card">
    <view wx:for="{{appointmentTypes}}" wx:key="type" class="appointment-item"><view><view class="appointment-title">{{item.title}}</view><view class="appointment-desc">{{item.desc}}</view></view><view wx:if="{{item.type !== 'discharge-notice' && !item.done}}" class="appointment-copy" data-type="{{item.type}}" bindtap="copyAppointment">预览并复制</view><view wx:if="{{item.type !== 'discharge-notice' && item.done}}" class="appointment-copy done">已完成</view><view wx:if="{{item.type === 'discharge-notice'}}" class="appointment-actions"><view class="appointment-copy" data-type="{{item.type}}" bindtap="copyAppointment">预览并复制</view><view class="appointment-copy {{item.done ? 'done' : ''}}" bindtap="markDischargeNoticeSent">{{item.done ? '已完成' : '标记已完成'}}</view></view></view>
  </view>

  <view wx:if="{{intraoperative}}" class="heading"><view class="section-title">术中交接</view><view class="task-count">仅记录一助医生</view></view>
  <view wx:if="{{intraoperative}}" class="intraop-card">
    <view class="intraop-person"><view><view class="status-label">一助医生</view><view class="intraop-person-name">{{patient.firstAssistant || '未填写'}}</view></view><picker wx:if="{{!archived && patient.careStatus !== '已出院'}}" mode="selector" range="{{intraopAssistantOptions}}" value="{{intraopAssistantIndex}}" bindchange="chooseIntraopFirstAssistant"><view class="intraop-person-edit">下拉选择　›</view></picker></view>
  </view>

  <view wx:if="{{postoperative}}" class="heading"><view class="section-title">术后重点记录</view><view wx:if="{{!archived && patient.careStatus !== '已出院'}}" class="add-link" bindtap="addDrain">＋ 添加引流</view></view>
  <view wx:if="{{postoperative}}" class="postop-card">
    <view class="postop-handoff">术中交接：一助 {{patient.firstAssistant || '未填写'}}</view>
    <view wx:if="{{drains.length === 0}}" class="postop-empty">暂无引流。手术后根据实际情况添加，可同时管理多根引流。</view>
    <view wx:if="{{drains.length}}" class="drain-table-actions"><view wx:if="{{!archived && patient.careStatus !== '已出院'}}" bindtap="addDrain">＋ 添加引流列</view><view wx:if="{{!archived && patient.careStatus !== '已出院' && drainTable.activeColumnCount}}" bindtap="addDrainRow">＋ 添加 POD 行</view></view>
    <scroll-view wx:if="{{drains.length}}" class="drain-table-scroll" scroll-x>
      <view class="drain-table" style="width: {{drainTable.width}}rpx;">
        <view class="drain-table-row drain-table-head"><view class="drain-table-pod">次数</view><view wx:for="{{drainTable.columns}}" wx:key="id" class="drain-table-cell">{{item.name}}<text wx:if="{{item.canDelete && !archived && patient.careStatus !== '已出院'}}" class="drain-delete" data-device-id="{{item.id}}" data-device-name="{{item.name}}" bindtap="removeDrainColumn">×</text></view></view>
        <view wx:for="{{drainTable.rows}}" wx:key="pod" class="drain-table-row"><view class="drain-table-pod">POD {{item.pod}}</view><block wx:for="{{item.cells}}" wx:for-item="cell" wx:key="deviceId"><view wx:if="{{cell.editable}}" class="drain-table-cell {{cell.entryType === 'removed' ? 'removed' : ''}}" data-device-id="{{cell.deviceId}}" data-device-name="{{cell.deviceName}}" data-pod="{{cell.pod}}" data-value="{{cell.value}}" bindtap="editDrainCell">{{cell.text}}</view><view wx:else class="drain-table-cell readonly {{cell.entryType === 'removed' ? 'removed' : ''}}">{{cell.text}}</view></block></view>
      </view>
    </scroll-view>
    <view wx:if="{{clinicalEvents.length}}" class="change-history"><view class="change-title">近期变化</view><view class="change-line" wx:for="{{clinicalEvents}}" wx:key="id"><view>{{item.typeLabel}}：{{item.valueLabel}}</view><text>{{item.timeText}}</text></view></view>
  </view>

  <view class="heading"><view class="section-title">查房工作板</view><view wx:if="{{!archived}}" class="add-link" bindtap="goRound">打开患者一览 ›</view></view>
  <view wx:if="{{patient.rounds.length}}" class="round-card"><view wx:for="{{patient.rounds}}" wx:key="id" class="round-item"><view class="round-date">{{item.date}}　{{item.timeText}}</view><view class="round-note">{{item.content}}</view></view></view>
  <view wx:if="{{!patient.rounds.length}}" class="empty-card">尚无查房记录</view>

  <view class="heading"><view class="section-title">待办事项</view><view class="task-count">{{patient.generalTasks.length}} 项</view></view>
  <view wx:if="{{!archived}}" class="task-input"><picker mode="selector" range="{{taskCategories}}" value="{{taskCategoryIndex}}" bindchange="chooseTaskCategory"><view class="task-category">{{taskCategories[taskCategoryIndex]}}　›</view></picker><picker mode="selector" range="{{taskPriorities}}" value="{{taskPriorityIndex}}" bindchange="chooseTaskPriority"><view class="task-category">{{taskPriorities[taskPriorityIndex]}}　›</view></picker><input placeholder="记录主刀交代或今日待办" value="{{newTask}}" bindinput="inputTask" /><view class="task-add" bindtap="addTask">添加</view></view>
  <view class="task-card" wx:for="{{patient.generalTasks}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleTask"><view class="check {{item.done ? 'checked' : ''}}">{{item.done ? '✓' : ''}}</view><view class="task-body {{item.done ? 'done' : ''}}"><view>{{item.title}}</view><view class="task-meta"><text class="{{item.priorityClass}}">{{item.priority}}</text>　{{item.category}}　·　{{item.dueText}}</view><view wx:if="{{item.completionNote}}" class="completion-note">完成备注：{{item.completionNote}}</view></view></view>
  <view wx:if="{{patient.generalTasks.length === 0}}" class="empty-card">暂无待办；可记录主刀交代</view>

  <view wx:if="{{!archived && patient.careStatus === '已出院'}}" class="archive-button" bindtap="archive">归档患者</view>
  <view wx:if="{{!archived && patient.careStatus === '已出院'}}" class="revoke-button" bindtap="revertDischarge">撤回出院</view>
  <view wx:if="{{archived}}" class="readonly-note">归档患者记录为只读，不参与主页提醒与在院统计。</view>
  <view wx:if="{{!archived && patient.careStatus !== '已出院'}}" class="revoke-button" bindtap="revokeRegistration">撤销建档（临时取消／误建档）</view>
  <wb-sheet visible="{{editor.visible}}" title="{{editor.title}}" description="{{editor.description}}" confirm-text="{{editor.confirmText}}" keyboard-height="{{editorKeyboardHeight}}" loading="{{editorSaveBusy}}" dirty="{{editor.dirty}}" bindcancel="closeEditor" bindconfirm="saveEditor">
    <input id="patient-detail-editor" class="editor-input" value="{{editor.content}}" placeholder="{{editor.placeholder}}" focus="{{editor.focus}}" adjust-position="false" bindinput="inputEditor" bindkeyboardheightchange="editorKeyboardChange" />
    <view wx:if="{{editor.warningText}}" class="sheet-warning"><view>请再次核对</view>{{editor.warningText}}</view>
  </wb-sheet>
  <wb-dialog visible="{{dialog.visible}}" title="{{dialog.title}}" message="{{dialog.message}}" confirm-text="{{dialog.confirmText}}" cancel-text="{{dialog.cancelText}}" show-cancel="{{dialog.showCancel}}" tone="{{dialog.tone}}" loading="{{dialog.loading}}" selectable="{{dialog.selectable}}" bindcancel="closeDialog" bindconfirm="confirmDialog" />
</view>
