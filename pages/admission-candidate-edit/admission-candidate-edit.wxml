<view class="page" wx:if="{{ready}}">
  <view class="privacy">【隐私】人工核对页仅在本机修改，不会发送患者资料。</view>
  <view class="note">逐项核对解析结果。未知患者类型、入院状态及国疗科室不会由系统猜测。</view>
  <view wx:if="{{incomplete}}" class="incomplete-banner">信息未完整：请补全下方红色高亮字段后再保存。</view>

  <view class="field-block"><input class="field {{formErrors.id ? 'field-error' : ''}}" placeholder="医院住院号 / 病案号" data-field="id" value="{{form.id}}" bindinput="input" /><view wx:if="{{formErrors.id}}" class="error-text">{{formErrors.id}}</view></view>
  <view class="field-block"><input class="field {{formErrors.name ? 'field-error' : ''}}" placeholder="姓名" data-field="name" value="{{form.name}}" bindinput="input" /><view wx:if="{{formErrors.name}}" class="error-text">{{formErrors.name}}</view></view>
  <view class="two"><view class="field-block"><input class="field {{formErrors.bed ? 'field-error' : ''}}" placeholder="{{form.admissionState === 'admitted' ? '床位（已入院必填）' : '床位（待入院可空）'}}" type="number" data-field="bed" value="{{form.bed}}" bindinput="input" /><view wx:if="{{formErrors.bed}}" class="error-text">{{formErrors.bed}}</view></view><view class="field-block"><input class="field" placeholder="年龄" type="number" data-field="age" value="{{form.age}}" bindinput="input" /></view></view>
  <view class="choice-row {{formErrors.gender ? 'field-error' : ''}}"><view>性别 *</view><view class="choices"><view wx:for="{{genders}}" wx:key="*this" class="choice {{form.gender === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="chooseGender">{{item}}</view></view></view><view wx:if="{{formErrors.gender}}" class="error-text">{{formErrors.gender}}</view>
  <view class="field-block"><input class="field {{formErrors.surgeon ? 'field-error' : ''}}" placeholder="主刀医生" data-field="surgeon" value="{{form.surgeon}}" bindinput="input" /><view wx:if="{{formErrors.surgeon}}" class="error-text">{{formErrors.surgeon}}</view></view>
  <picker mode="selector" range="{{firstAssistantOptions}}" value="{{firstAssistantIndex}}" bindchange="chooseFirstAssistant"><view class="picker">一助医生：{{firstAssistantOptions[firstAssistantIndex] || '请选择'}}　›</view></picker>
  <block wx:if="{{customAssistantMode}}"><input class="field" placeholder="填写其他一助医生" value="{{customAssistant}}" bindinput="inputCustomAssistant" /><view class="choice-row"><view>加入一助选择列表</view><switch checked="{{addCustomAssistantToLibrary}}" color="#2d70d8" bindchange="toggleCustomAssistantLibrary" /></view></block>
  <view class="choice-row {{formErrors.managedByDaihuanyu ? 'field-error' : ''}}"><view>由代寰宇负责管理 *</view><switch checked="{{form.managedByDaihuanyu}}" color="#2d70d8" bindchange="changeManaged" /></view><view wx:if="{{formErrors.managedByDaihuanyu}}" class="error-text">{{formErrors.managedByDaihuanyu}}</view>

  <view class="choice-row {{formErrors.patientType ? 'field-error' : ''}}"><view>患者类型 *</view><view class="choices"><view wx:for="{{patientTypes}}" wx:key="*this" class="choice type {{form.patientType === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="choosePatientType">{{item}}</view></view></view><view wx:if="{{formErrors.patientType}}" class="error-text">{{formErrors.patientType}}</view>
  <view class="choice-row {{formErrors.admissionState ? 'field-error' : ''}}"><view>入院状态 *</view><view class="choices"><view class="choice state {{form.admissionState === 'planned' ? 'selected' : ''}}" data-value="planned" bindtap="chooseAdmissionState">待入院</view><view class="choice state {{form.admissionState === 'admitted' ? 'selected' : ''}}" data-value="admitted" bindtap="chooseAdmissionState">已入院</view></view></view><view wx:if="{{formErrors.admissionState}}" class="error-text">{{formErrors.admissionState}}</view>
  <picker mode="selector" range="{{departments}}" value="{{departmentIndex}}" bindchange="chooseDepartment"><view class="picker {{formErrors.department ? 'field-error' : ''}}">科室：{{form.department || '请选择科室'}}　›</view></picker><view wx:if="{{formErrors.department}}" class="error-text">{{formErrors.department}}</view>
  <picker wx:if="{{wardOptions.length > 1}}" mode="selector" range="{{wardOptions}}" value="{{wardIndex}}" bindchange="chooseWard"><view class="picker {{formErrors.ward ? 'field-error' : ''}}">病房：{{form.ward || '请选择病房'}}　›</view></picker><view wx:if="{{formErrors.ward}}" class="error-text">{{formErrors.ward}}</view>
  <input class="field" placeholder="诊断简称（可选）" data-field="diagnosis" value="{{form.diagnosis}}" bindinput="input" />
  <view class="choice-row"><view>过敏史</view><view class="choices"><view wx:for="{{allergyOptions}}" wx:key="value" class="choice {{form.allergyStatus === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="chooseAllergyStatus">{{item.label}}</view></view></view>
  <input wx:if="{{form.allergyStatus === 'present'}}" class="field {{formErrors.allergies ? 'field-error' : ''}}" placeholder="过敏原及反应" data-field="allergies" value="{{form.allergies}}" bindinput="input" /><view wx:if="{{formErrors.allergies}}" class="error-text">{{formErrors.allergies}}</view>

  <picker mode="date" value="{{form.admissionDate}}" data-field="admissionDate" bindchange="input"><view class="picker {{formErrors.admissionDate ? 'field-error' : ''}}">{{form.admissionState === 'planned' ? '计划入院' : form.admissionState === 'admitted' ? '实际入院' : '入院日期'}}：{{form.admissionDate || '请选择'}}　›</view></picker><view wx:if="{{formErrors.admissionDate}}" class="error-text">{{formErrors.admissionDate}}</view>
  <view wx:if="{{form.patientType !== '日间'}}" class="date-line"><picker mode="date" value="{{form.surgeryDate}}" data-field="surgeryDate" bindchange="input"><view class="picker {{formErrors.surgeryDate ? 'field-error' : ''}}">手术：{{form.surgeryDate || '未定'}}　›</view></picker><view wx:if="{{form.surgeryDate}}" class="clear" data-field="surgeryDate" bindtap="clearDate">清除</view></view><view wx:else class="picker">手术：{{form.admissionDate || '先选入院日'}}（日间同日）</view><view wx:if="{{formErrors.surgeryDate}}" class="error-text">{{formErrors.surgeryDate}}</view>
  <view wx:if="{{form.patientType !== '日间'}}" class="date-line"><picker mode="date" value="{{form.plannedDischargeDate}}" data-field="plannedDischargeDate" bindchange="input"><view class="picker {{formErrors.plannedDischargeDate ? 'field-error' : ''}}">计划出院：{{form.plannedDischargeDate || '未定'}}　›</view></picker><view wx:if="{{form.plannedDischargeDate}}" class="clear" data-field="plannedDischargeDate" bindtap="clearDate">清除</view></view><view wx:else class="picker">计划出院：{{form.admissionDate || '先选入院日'}}（日间同日）</view><view wx:if="{{formErrors.plannedDischargeDate}}" class="error-text">{{formErrors.plannedDischargeDate}}</view>
  <input class="field" placeholder="拟行术式（可选）" data-field="surgeryName" value="{{form.surgeryName}}" bindinput="input" />
  <view class="save" bindtap="save">保存并重新校验</view>
</view>
