page { background: #f5f6f8; }
.page { min-height: 100vh; padding: 22rpx 24rpx 70rpx; box-sizing: border-box; color: #172033; }
.privacy, .note, .incomplete-banner { padding: 16rpx 18rpx; border-radius: 14rpx; font-size: 21rpx; line-height: 31rpx; }
.privacy { color: #81541f; background: #fff4dd; }.note { margin-top: 12rpx; color: #627187; background: #eef4fb; }.incomplete-banner { margin-top: 12rpx; color: #a3322d; background: #fff0ed; font-weight: 650; }
.field-block { min-width: 0; flex: 1; }.field, .picker { width: 100%; box-sizing: border-box; margin-top: 13rpx; border: 2rpx solid transparent; border-radius: 16rpx; background: #fff; font-size: 23rpx; }.field { height: 74rpx; padding: 0 17rpx; }.picker { min-height: 74rpx; padding: 19rpx 17rpx; color: #4f5d70; line-height: 34rpx; }
.two { display: flex; gap: 12rpx; }.choice-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 12rpx 14rpx 12rpx 17rpx; margin-top: 13rpx; border: 2rpx solid transparent; border-radius: 16rpx; background: #fff; color: #4f5d70; font-size: 23rpx; }.choices { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8rpx; }.choice { min-width: 68rpx; padding: 12rpx 6rpx; border-radius: 12rpx; color: #738094; background: #edf0f4; text-align: center; font-size: 21rpx; }.choice.type, .choice.state { min-width: 82rpx; }.choice.selected { color: #fff; background: #2d70d8; }
.field-error { border-color: #dd4a43 !important; background: #fff7f6 !important; }.error-text { margin: 7rpx 5rpx 0; color: #bd332d; font-size: 20rpx; line-height: 28rpx; }.date-line { display: flex; align-items: center; gap: 10rpx; }.date-line picker { min-width: 0; flex: 1; }.clear { flex: none; margin-top: 13rpx; padding: 18rpx 14rpx; border-radius: 12rpx; color: #a4423d; background: #fff0ed; font-size: 20rpx; }.save { margin-top: 28rpx; padding: 19rpx; border-radius: 17rpx; color: #fff; background: #2d70d8; text-align: center; font-size: 25rpx; font-weight: 700; }
